generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  author      String
  language    String
  status      String?    @default("wishlist")
  rating      Int?
  userId      String   //Clerk dan keladi
  type        String? 
  hooks       String?
  pages       String?
  maslahatBeraman Boolean @default(true)
  cost        String?    @default("0")
  createdAt   DateTime  @default(now())
}
